# Copy to .env and fill in.
PORT=3001

# ---- WhatsApp Cloud API (Meta) – optional, not part of the current flow ----
# false: the server only runs the website chat. true: also run the webhook and the WhatsApp bot,
# which needs the values below (Meta for Developers > your app > WhatsApp > API Setup).
WHATSAPP_ENABLED=false

WHATSAPP_ACCESS_TOKEN=paste-your-access-token-here
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Who gets the test message: country code + number, digits only, e.g. 4917612345678
WHATSAPP_TEST_RECIPIENT=

# Webhook (App Dashboard > WhatsApp > Configuration).
# Verify token: any secret string; enter the same one in the dashboard as "Verify token".
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret: App Dashboard > App settings > Basic > App secret. Required when NODE_ENV=production.
WHATSAPP_APP_SECRET=paste-your-app-secret-here

# Bot replies to incoming messages: true = only print them in the terminal (nothing is sent to Meta),
# false = send them on WhatsApp.
WHATSAPP_DRY_RUN=true
# The website's address, e.g. https://www.example.com. Turns site links in replies (like /contact#catering)
# into full links; while empty, those links are left out.
SITE_URL=
